{
  "realm": "partner-agent",
  "displayName": "Partner Agent System",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "partner",
        "description": "Partner agent user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "groups": [],
  "users": [],
  "identityProviders": [
    {
      "alias": "spiffe",
      "displayName": "SPIFFE/SPIRE Workload Identity",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "spiffe-federation",
        "clientAuthMethod": "private_key_jwt",
        "useJwksUrl": "true",
        "jwksUrl": "http://spire-oidc-provider:8443/keys",
        "tokenUrl": "",
        "authorizationUrl": "",
        "issuer": "https://oidc-discovery.partner.example.com",
        "defaultScope": "openid",
        "syncMode": "IMPORT",
        "validateSignature": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "agent-service",
      "name": "Agent Service (audience-only target)",
      "description": "Audience-only target client for RFC 8693 token exchange — agent-service validates tokens scoped to this audience",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "kubernetes-agent",
      "name": "Kubernetes Agent (audience-only target)",
      "description": "Audience-only target client for RFC 8693 token exchange",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "partner-agent-ui",
      "name": "Partner Agent UI Client",
      "description": "OIDC client for partner agent web UI and API authentication - CONFIDENTIAL with token exchange",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://localhost:8001/*",
        "http://localhost:8002/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8000",
        "http://localhost:8001",
        "http://localhost:8002",
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "attributes": {
        "access.token.lifespan": "1800",
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "audience-resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        },
        {
          "name": "audience-agent-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-kubernetes-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kubernetes-agent",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
