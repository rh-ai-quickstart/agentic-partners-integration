# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/partner_agent

# LLM Configuration - Recommended: Local open-weight model with Ollama
# Run Ollama locally: docker run -d -p 11434:11434 --name ollama ollama/ollama
# Pull a model: docker exec ollama ollama pull llama3.2
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434

# Alternative: External API providers (requires API key)
# AI_API_KEY=your-api-key-here
# AI_PROVIDER=gemini  # or openai, anthropic
# AI_MODEL=gemini-2.5-flash

# Alternative: Provider-specific keys (for multi-provider setups)
# AI_GEMINI_API_KEY=your-gemini-key
# AI_OPENAI_API_KEY=your-openai-key
# AI_ANTHROPIC_API_KEY=your-anthropic-key

# Legacy (deprecated - maintained for backward compatibility)
# LLM_BACKEND=gemini  # Use AI_PROVIDER instead
# GOOGLE_API_KEY=AI......asdf  # Use AI_API_KEY or AI_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash  # Use AI_MODEL

# ---------------------------------------------------------------------------
# Social Login / Identity Providers (optional)
#
# Leave any section empty to skip that provider.  When set, Keycloak
# automatically shows the corresponding "Login with …" button on the
# sign-in page.  A user who logs in via a social provider is matched to an
# existing local Keycloak account by email; if no local account exists,
# Keycloak creates one with empty departments — they can log in but OPA
# blocks all agents until an admin assigns their departments in the DB.
#
# ── Google / Gmail ──────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI:
#    http://localhost:8090/realms/partner-agent/broker/google/endpoint
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# ── GitHub ──────────────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Set Homepage URL: http://localhost:3000
# 3. Set Authorisation callback URL:
#    http://localhost:8090/realms/partner-agent/broker/github/endpoint
# 4. Generate a Client Secret
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# ── Microsoft (Entra ID / Azure AD) ─────────────────────────────────────
# 1. Go to https://portal.azure.com → App registrations → New registration
# 2. Add Redirect URI (Web):
#    http://localhost:8090/realms/partner-agent/broker/microsoft/endpoint
# 3. Add API permission: openid, email, profile (Microsoft Graph)
# 4. Generate a client secret under Certificates & Secrets
# 5. Optional: set MICROSOFT_TENANT to your organisation's tenant ID to
#    restrict login to a single Azure AD tenant (defaults to "common" which
#    allows personal + work Microsoft accounts)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# ---------------------------------------------------------------------------

# Communication
COMMUNICATION_MODE=http
AGENT_SERVICE_URL=http://127.0.0.1:8001
AGENT_TIMEOUT=120

# Logging
LOG_LEVEL=INFO

# Service Configuration
REQUEST_MANAGER_PORT=8000
AGENT_SERVICE_PORT=8001

# ---------------------------------------------------------------------------
# Agent Discovery (Change 4 — 3-tier registry cascade)
#
# REGISTRY_TTL_SECONDS — how long the agent registry is cached in the
#   request-manager before re-fetching.  Default 300 (5 minutes).
#   Reduce for faster discovery of newly deployed agents.
# REGISTRY_TTL_SECONDS=300
#
# AGENT_CARD_DISCOVERY — enables Tier-2 discovery: after the YAML
#   registry is fetched (Tier 3), the request-manager also GETs
#   /.well-known/agent-card.json from each agent's base URL and uses
#   the card's authoritative invoke URL if available.
#   Default: false (opt-in; set to true when agents serve their own cards).
# AGENT_CARD_DISCOVERY=false
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dynamic Client Registration / Agent Card Security (Changes 2 + 5)
#
# DCR_ENABLED — when true (default), agents self-register with Keycloak on
#   startup using the Initial Access Token from seed-keycloak.sh.  No manual
#   per-agent client configuration needed in Keycloak.
#   Set to false only for local dev WITHOUT a running Keycloak instance.
# DCR_ENABLED=true
#
# KEYCLOAK_ADMIN_USERNAME / KEYCLOAK_ADMIN_PASSWORD — used by DCR client to
#   call the Admin API right after registration to switch the new Keycloak client
#   from "standard token exchange" (strict audience check, Keycloak 26 default)
#   to "legacy token exchange" (permissive — any service account can exchange).
#   Defaults to admin/admin123. Override if your Keycloak admin credentials differ.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin123
#
# KEYCLOAK_DCR_INITIAL_ACCESS_TOKEN — set automatically by seed-services.sh
#   from /tmp/dcr_initial_access_token.txt (written by seed-keycloak.sh).
#   Set manually if running agents outside the standard setup flow.
# KEYCLOAK_DCR_INITIAL_ACCESS_TOKEN=
#
# KEYCLOAK_TOKEN_URL — overrides the OAuth2 token endpoint advertised in
#   agent cards (security_schemes.partner-oauth2.flows.clientCredentials.tokenUrl).
#   Defaults to http://keycloak:8090/realms/partner-agent/protocol/openid-connect/token.
#   Set this to your public-facing Keycloak URL in production.
# KEYCLOAK_TOKEN_URL=https://sso.example.com/realms/partner-agent/protocol/openid-connect/token
#
# KEYCLOAK_METADATA_URL — OpenID Connect discovery document URL advertised
#   in agent cards (security_schemes.partner-oauth2.oauth2MetadataUrl).
# KEYCLOAK_METADATA_URL=https://sso.example.com/realms/partner-agent/.well-known/openid-configuration
#
# SPIFFE_TRUST_DOMAIN — the SPIFFE trust domain advertised in agent cards
#   (security_schemes.partner-mtls.description).  Callers must present
#   a client cert whose SAN is a SPIFFE URI under this trust domain.
#   Default: partner.example.com
# SPIFFE_TRUST_DOMAIN=partner.example.com
#
# GATEWAY_BASE_URL — the public base URL of the agent-service gateway.
#   Used in the root /.well-known/agent-card.json directory and in
#   individual agent card invoke URLs.
# GATEWAY_BASE_URL=https://agents.example.com
# ---------------------------------------------------------------------------
