# Containerfile for azure-mcp-server
#
# Uses the official Red Hat MCP catalog image directly with Azure AD
# JWT Bearer authentication.  No proxy is needed — the ARO agent
# acquires tokens via client_credentials and passes them as Bearer
# headers on every MCP request.
#
# The Helm chart sets the image to this Red Hat catalog image and
# overrides the entrypoint to run with --read-only and auth enabled.
# This Containerfile only wraps the upstream image with the env vars
# needed for OpenShift (non-root, writable tmp dirs).
#
# Pinned to tag 1774539732-dotnet-builder (v2.0.0-beta.28) to avoid
# breakage from upstream changes.

FROM quay.io/rhoai-partner-mcp/ubi10-ms-azure-mcp-server:1774539732-dotnet-builder

# .NET runtime needs writable dirs under /tmp
RUN mkdir -p /tmp/.net /tmp/.cache /tmp/.aspnet && \
    chmod -R 777 /tmp/.net /tmp/.cache /tmp/.aspnet && \
    chgrp -R 0 /mcp-server && chmod -R g=u /mcp-server

USER 1001

ENV HOME=/tmp
ENV DOTNET_ROOT=/usr/lib64/dotnet
ENV DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp/.net
ENV ASPNETCORE_URLS=http://+:8080

EXPOSE 8080

ENTRYPOINT ["/mcp-server/azmcp"]
CMD ["server", "start", "--transport", "http", "--read-only", "--outgoing-auth-strategy", "UseHostingEnvironmentIdentity"]
