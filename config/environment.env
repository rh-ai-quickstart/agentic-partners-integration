# ═══════════════════════════════════════════════════════════
# PARTNER AGENT SYSTEM - ENVIRONMENT CONFIGURATION
# Single source of truth for all environment variables
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=partner_agent
DATABASE_URL=postgresql://user:pass@partner-postgres-full:5432/partner_agent

# ───────────────────────────────────────────────────────────
# Keycloak Configuration
# ───────────────────────────────────────────────────────────
KEYCLOAK_URL=http://partner-keycloak-full:8080
KEYCLOAK_REALM=partner-agent
KEYCLOAK_CLIENT_ID=partner-agent-ui
# Client secret is fetched dynamically from Keycloak API
# Set this after running seed-keycloak.sh
KEYCLOAK_CLIENT_SECRET=

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ───────────────────────────────────────────────────────────
# SPIRE Configuration
# ───────────────────────────────────────────────────────────
SPIRE_SERVER_URL=spire-server:8081
SPIRE_SERVER_CONTAINER=partner-spire-server
SPIFFE_ENDPOINT_SOCKET=/run/spire/sockets/agent.sock
SPIRE_TRUST_DOMAIN=partner.example.com

# ───────────────────────────────────────────────────────────
# OPA Configuration
# ───────────────────────────────────────────────────────────
OPA_URL=http://partner-opa-full:8181

# ───────────────────────────────────────────────────────────
# Service URLs (Internal Docker Network)
# ───────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://partner-agent-service-full:8080
REQUEST_MANAGER_URL=http://partner-request-manager-full:8080
KUBERNETES_AGENT_URL=http://partner-kubernetes-agent-full:8080
RAG_API_URL=http://partner-rag-api-full:8080

# ───────────────────────────────────────────────────────────
# Service Ports (Host Exposure)
# ───────────────────────────────────────────────────────────
REQUEST_MANAGER_PORT=8000
AGENT_SERVICE_PORT=8001
KUBERNETES_AGENT_PORT=8002
RAG_API_PORT=8003
WEB_UI_PORT=3000
KEYCLOAK_PORT=8090
OPA_PORT=8181
POSTGRES_PORT=5433

# ───────────────────────────────────────────────────────────
# AI/LLM Configuration
# ───────────────────────────────────────────────────────────
# Default provider
AI_PROVIDER=gemini
# API keys (set your own)
AI_API_KEY=
AI_GEMINI_API_KEY=
AI_OPENAI_API_KEY=
# Deprecated (kept for backwards compatibility)
GOOGLE_API_KEY=

# ───────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ───────────────────────────────────────────────────────────
# Security Settings
# ───────────────────────────────────────────────────────────
# JWT Token TTL (seconds)
ACCESS_TOKEN_LIFETIME=1800
REFRESH_TOKEN_LIFETIME=3600

# Session settings
SESSION_TIMEOUT=3600
SESSION_MAX_LIFETIME=36000

# ───────────────────────────────────────────────────────────
# Auto-Registration Daemon
# ───────────────────────────────────────────────────────────
SPIRE_AUTO_REGISTER_ENABLED=true
SPIRE_AUTO_REGISTER_INTERVAL=5

# ───────────────────────────────────────────────────────────
# Notes:
# ───────────────────────────────────────────────────────────
# - Service names (partner-*) are for Docker networking
# - Ports are exposed on host machine
# - URLs use container names for internal communication
# - Secrets should be rotated in production
# - This file can be loaded with: set -a; source config/environment.env; set +a
# ═══════════════════════════════════════════════════════════
